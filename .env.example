# DigiParc Fleet Management - Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_NAME="DigiParc Fleet Management"
APP_URL=http://localhost
APP_ENV=development
DEBUG=true

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digiparc
DB_USER=root
DB_PASS=your_database_password

# ==============================================
# SECURITY & AUTHENTICATION
# ==============================================
# Generate a secure random string for JWT authentication
# You can use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Session configuration
SESSION_LIFETIME=7200
SESSION_NAME=DIGIPARC_SESSION

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=noreply@digiparc.com
SMTP_FROM_NAME="DigiParc System"

# ==============================================
# SMS CONFIGURATION (Twilio)
# ==============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# WHATSAPP CONFIGURATION (Twilio WhatsApp API)
# ==============================================
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ==============================================
# PUSH NOTIFICATIONS (Web Push)
# ==============================================
# Generate VAPID keys with: web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@digiparc.com

# ==============================================
# STRIPE PAYMENT INTEGRATION
# ==============================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product/Price IDs for subscription plans
STRIPE_STARTER_PRICE_ID=price_starter_plan_id
STRIPE_BUSINESS_PRICE_ID=price_business_plan_id
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_plan_id

# ==============================================
# GOOGLE MAPS API (for tracking)
# ==============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
BACKUP_PATH=/var/backups/digiparc
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Backup encryption (optional)
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key

# ==============================================
# FILE UPLOADS
# ==============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
UPLOAD_PATH=/var/www/digiparc/public/uploads

# ==============================================
# CRON JOBS
# ==============================================
# Set to true to enable CRON job execution
CRON_ENABLED=true

# Alert checking frequency (in minutes)
CRON_ALERTS_FREQUENCY=60

# Backup frequency (daily at 2 AM)
CRON_BACKUP_TIME="0 2 * * *"

# ==============================================
# EXTERNAL APIs
# ==============================================
# Weather API (optional, for route planning)
WEATHER_API_KEY=your_weather_api_key

# Fuel price API (optional)
FUEL_PRICE_API_KEY=your_fuel_price_api_key

# ==============================================
# CARBON TRACKING
# ==============================================
# Use ADEME emission factors (France) or custom
CARBON_EMISSION_STANDARD=ADEME_2025

# ==============================================
# LOCALIZATION
# ==============================================
DEFAULT_LANGUAGE=fr
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_CURRENCY=EUR

# Available languages: fr, en, es, de, ar
AVAILABLE_LANGUAGES=fr,en,es,de,ar

# ==============================================
# PERFORMANCE & CACHING
# ==============================================
# Redis configuration (optional, for caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Cache TTL (in seconds)
CACHE_TTL=3600

# ==============================================
# RATE LIMITING (API)
# ==============================================
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug
LOG_PATH=/var/log/digiparc
LOG_MAX_FILES=30

# ==============================================
# MAINTENANCE MODE
# ==============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."

# ==============================================
# ANALYTICS & MONITORING
# ==============================================
# Google Analytics (optional)
GA_TRACKING_ID=

# Sentry error tracking (optional)
SENTRY_DSN=

# ==============================================
# MULTI-TENANCY
# ==============================================
# Enable/disable multi-company support
MULTI_TENANT=true

# ==============================================
# SECURITY HEADERS
# ==============================================
SECURITY_HEADERS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_CARBON_TRACKING=true
FEATURE_GDPR_COMPLIANCE=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_SMART_DELIVERY=true
FEATURE_PASSENGER_TRANSPORT=true
FEATURE_RENTAL_MODULE=true

# ==============================================
# DEVELOPMENT ONLY
# ==============================================
# SQL query logging
SQL_DEBUG=false

# Show detailed error messages
SHOW_ERRORS=true

# ==============================================
# NOTES
# ==============================================
# - Never commit the .env file to version control
# - Keep all secrets secure and rotate them regularly
# - Use strong passwords and random strings for all keys
# - Enable HTTPS in production
# - Configure firewall rules for database access
# - Set up SSL certificates for email and webhooks
# - Review and update this configuration regularly
